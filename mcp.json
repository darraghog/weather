{
  "mcpServers": {
    "weather-local": {
      "command": "uv",
      "args": [
        "run",
        "python",
        "weather.py"
      ],
      "env": {}
    },
    "weather-remote": {
      "url": "https://carole-unrealizable-thermochemically.ngrok-free.dev/mcp",
      "transport": "streamable-http",
      "headers": {
